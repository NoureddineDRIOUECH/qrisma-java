spring:
  datasource:
    url: ${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/qrisma}
    username: ${SPRING_DATASOURCE_USERNAME:qrisma}
    password: ${SPRING_DATASOURCE_PASSWORD:qrisma}
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        format_sql: true
  flyway:
    enabled: true
    locations: classpath:db/migration

server:
  port: 8080

app:
  jwt:
    secret: ${JWT_SECRET:change-me}
    expiration-ms: 3600000

google:
  wallet:
    issuerId: ${GOOGLE_WALLET_ISSUER_ID:}
    serviceAccountJson: ${GOOGLE_SERVICE_ACCOUNT_JSON:}
